# ─── Open Truly Chat — serv00 Environment Config ───────────────────────────
# Copy this file to .env and fill in your values

# OpenAI API key (or OpenRouter key starting with sk-or-v1-)
OPENAI_API_KEY=your-openai-api-key-here

# ── Security (REQUIRED — change these!) ──────────────────────────────────────
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=change-this-to-a-random-64-char-string
NODE_ENV=production

# ── MongoDB (use serv00 MongoDB: mongo13.serv00.com) ─────────────────────────
# Format: mongodb://user:password@mongo13.serv00.com:27017/open_truly_chat
MONGODB_URI=mongodb://your-user:your-password@mongo13.serv00.com:27017/open_truly_chat

# ── Server port (must match the port you reserved in serv00 panel) ───────────
PORT=12345

# ── Your serv00 domain/URL (used for keep-alive pings) ───────────────────────
APP_URL=https://your-username.serv00.com

# ── WhatsApp Baileys auth folder (where session files are stored) ─────────────
WA_AUTH_FOLDER=./auth_info_baileys

# ── Optional: disable WhatsApp (run web UI only) ─────────────────────────────
# ENABLE_WHATSAPP=false

# ── Optional: CORS origin (use your domain in production) ────────────────────
# ALLOWED_ORIGIN=https://your-domain.serv00.com

# ── Keep-Alive (pings /health to prevent process sleep) ──────────────────────
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL=840000

# ── OpenRouter (optional — only if using OpenRouter instead of OpenAI) ────────
# OPENROUTER_REFERRER=https://github.com
# OPENROUTER_TITLE=Open Truly Chat
