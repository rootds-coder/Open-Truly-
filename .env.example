# Server Port
PORT=3000

# OpenRouter AI API Key (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MongoDB Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wsapai?retryWrites=true&w=majority

# Enable/Disable WhatsApp Integration (true/false)
ENABLE_WHATSAPP=true

# Custom WhatsApp Auth Folder Path
WA_AUTH_FOLDER=./auth_info_baileys

# Keep-Alive Ping Settings (prevents host sleep)
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL=600000
